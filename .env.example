# Choose exactly one provider: ark or zhipu
AI_PROVIDER=ark

# Volcengine Ark: API Key from the Ark console.
ARK_API_KEY=
# Ark chat completion expects the inference endpoint ID, for example ep-xxxxxxxx.
ARK_MODEL=ep-your-vision-endpoint-id
# Optional; only change if you use another Ark region or compatible endpoint.
# ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# Zhipu GLM-4V alternative. Set AI_PROVIDER=zhipu and provide this key instead.
# ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4v
# ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
